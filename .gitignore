# ========================================================
# FinPilot AI — Git Ignore
# ========================================================

# --- Dependencies ---
node_modules/
*/node_modules/
.pnp
.pnp.js
.pnpm-store/

# --- Environment & Secret Credentials ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
backend/.env
# Keep environment templates tracked
!.env.example
!backend/.env.example

# --- Logs & Debugging ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Runtime & Scratch / Temporary Files ---
scratch/
temp/
tmp/
.cache/
.parcel-cache/

# --- Build & Output Folders ---
dist/
build/
out/
.next/
coverage/
.nyc_output/

# --- Operating System Files ---
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/

# --- IDE & Editor Settings ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# --- Antigravity / AI Agent Scratch Artifacts ---
.gemini/

